#!/usr/bin/env python3
"""Clone-run launcher.

Run Tinjis straight from a checkout with no installation step and no package
manager: this shim puts the checkout root on ``sys.path`` and calls the CLI.
Bytecode writing is disabled so a read-only run leaves the checkout untouched.
"""

from __future__ import annotations

import pathlib
import sys

CHECKOUT = pathlib.Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(CHECKOUT))

from tinjis.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
